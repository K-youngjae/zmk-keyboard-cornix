#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// Layer Mapping

#define BASE 0
#define NUM  1
#define NAVI 2
#define BLTSET  3

// 타이핑 감도 설정

#define HM_TAPPING_TERM 250
#define HM_PRIOR_IDLE 125

// 헤더 파일의 키 포지션을 그룹화

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        ht_char: hold_tap_char {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        th: tap_key_hold_to {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced"; // key first
            tapping-term-ms = <500>;  // <= 250ms press to layer
            bindings = <&to>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        cap_td: caps_tap_Dance {
            compatible = "zmk,behavior-tap-dance";
            label = "caps_tap_Dance";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        td_mail_head: td_mail_head {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MAIL_HEAD";
            #binding-cells = <0>;
            bindings = <&kp U>, <&m_mail_head>;
        };

        td_mail_tail: td_mail_tail {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MAIL_TAIL";
            #binding-cells = <0>;
            bindings = <&kp I>, <&m_mail_tail>;
        };
    };

    macros {
        m_mail_head: m_mail_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp K &kp S &kp S &kp U &kp D &kp G &kp K &kp T &kp P &kp D &kp Y &kp COMMA &kp SPACE &kp W &kp J &kp S &kp W &kp K &kp V &kp U &kp S &kp D &kp M &kp L &kp W &kp P &kp D &kp J &kp R &kp O &kp Q &kp K &kp F &kp N2 &kp X &kp L &kp A &kp SPACE &kp R &kp L &kp A &kp D &kp U &kp D &kp W &kp O &kp D &kp L &kp Q &kp S &kp L &kp E &kp K &kp DOT &kp RET &kp RET>;
            label = "M_MAIL_HEAD";
        };

        m_mail_tail: m_mail_tail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp R &kp K &kp A &kp T &kp K &kp G &kp K &kp Q &kp S &kp L &kp E &kp K &kp DOT>;
            label = "M_MAIL_TAIL";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&th 3 ESC  &kp Q     &kp W         &kp E    &kp R      &kp T      &kp Y       &td_mail_head  &td_mail_tail  &kp O          &kp P            &kp BSPC
&kp TAB    &kp A     &kp S         &th 2 D  &th 1 F    &kp G      &kp H       &th 1 J        &th 2 K        &hm_r LCTRL L  &kp SEMI         &kp DEL
&kp LSHFT  &kp Z     &kp X         &kp C    &kp V      &kp B      &bt BT_PRV  &bt BT_NXT     &ht_char B N   &kp M          &kp COMMA        &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LEFT_ALT  &cap_td  &kp SPACE  &kp ENTER  &kp ENTER   &kp SPACE      &kp RALT       &kp F5         &kp PRINTSCREEN  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NUM_layer {
            display-name = "NUM";
            bindings = <
&kp GRAVE  &kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT  &kp N7  &kp N8  &kp N9     &kp PLUS   &kp MINUS  &kp BSPC
&kp TAB    &kp CARET  &kp AMPS  &kp ASTRK  &kp SQT   &kp DQT    &kp N4  &kp N5  &kp N6     &kp ASTRK  &kp SLASH  &kp ENTER
&kp LPAR   &kp RPAR   &kp LBRC  &kp RBRC   &kp LBKT  &kp RBKT   &none   &none   &kp N1     &kp N2     &kp N3     &none      &kp UP  &kp RSHFT
&kp LCTRL  &none      &none     &none      &none     &to 0      &to 0   &kp N0  &kp ENTER  &kp LEFT   &kp DOWN   &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Navi_layer {
            display-name = "NAVI";
            bindings = <
&none  &none  &none           &kp UP_ARROW    &kp PAGE_UP      &kp PAGE_DOWN   &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP    &msc SCRL_DOWN  &none
&none  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LEFT_SHIFT  &none           &none
&none  &none  &none           &none           &kp LCTRL        &msc SCRL_DOWN  &trans          &trans          &kp LCTRL        &none           &none           &none  &none  &none
&none  &none  &none           &none           &none            &to 0           &to 0           &kp LCTRL       &none            &none           &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BLT_layer {
            display-name = "BLTSET";
            bindings = <
&to 0         &bt BT_CLR_ALL  &bt BT_CLR    &none         &none         &none  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &trans  &trans  &trans  &trans  &trans  &trans
&none         &none           &none         &none         &none         &none  &none   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none         &none           &none         &none         &none         &to 0  &to 0   &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
