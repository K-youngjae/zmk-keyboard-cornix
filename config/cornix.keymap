#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// Layer Mapping

#define BASE 0
#define NUM  1
#define NAVI 2
#define FUNC 3
#define BLT  4

// Typing Sensitivity

#define HM_TAPPING_TERM 250
#define HM_PRIOR_IDLE 125

// Group key positions in header files

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        ht_char: hold_tap_char {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
        };

        th: tap_key_hold_to {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; // key first
            tapping-term-ms = <300>;  // <= 250ms press to layer
            bindings = <&to>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        cap_td: caps_tap_Dance {
            compatible = "zmk,behavior-tap-dance";
            label = "caps_tap_Dance";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        td_mail_head: td_mail_head {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MAIL_HEAD";
            #binding-cells = <0>;
            bindings = <&kp U>, <&m_mail_head>;
        };

        td_mail_tail: td_mail_tail {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MAIL_TAIL";
            #binding-cells = <0>;
            bindings = <&kp I>, <&m_mail_tail>;
        };

        td_alt_f4: td_alt_f4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ALT_F4";
            #binding-cells = <0>;
            bindings = <&kp F5>, <&kp LA(F4)>;

            tapping-term-ms = <250>;
        };

        scroll_enc: scroll_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <30>;
        };

        bt_prof_enc: bt_prof_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
            tap-ms = <30>;
        };
    };

    macros {
        m_mail_head: m_mail_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>; // 안정성을 위해 15ms로 살짝 상향
            tap-ms = <15>;
            bindings = <&kp W &kp J &kp S &kp W &kp K &kp V &kp U &kp S &kp D &kp M &kp L &kp W &kp P &kp D &kp J &kp R &kp O &kp Q &kp K &kp F &kp N2 &kp X &kp L &kp A>;
            label = "M_MAIL_HEAD";
        };

        m_mail_tail: m_mail_tail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&kp R &kp K &kp A &kp T &kp K &kp G &kp K &kp Q &kp S &kp L &kp E &kp K &kp DOT>;
            label = "M_MAIL_TAIL";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&th 4 ESC  &kp Q     &kp W     &kp E    &kp R      &kp T      &kp Y       &td_mail_head  &td_mail_tail  &kp O          &kp P      &kp BSPC
&kp TAB    &kp A     &th 3 S   &th 2 D  &th 1 F    &kp G      &kp H       &th 1 J        &th 2 K        &hm_r LCTRL L  &kp SEMI   &kp DEL
&kp LSHFT  &kp Z     &kp X     &kp C    &kp V      &kp B      &bt BT_PRV  &bt BT_NXT     &ht_char B N   &kp M          &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &cap_td  &kp SPACE  &kp ENTER  &kp ENTER   &kp SPACE      &kp RALT       &td_alt_f4     &kp PSCRN  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        NUM_layer {
            display-name = "NUM";
            bindings = <
&kp GRAVE  &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT  &kp N7  &kp N8  &kp N9     &kp PLUS   &kp MINUS  &kp BSPC
&kp TAB    &kp CARET  &kp AMPS  &kp ASTRK  &kp SQT    &kp DQT    &kp N4  &kp N5  &kp N6     &kp ASTRK  &kp SLASH  &kp ENTER
&kp LPAR   &kp RPAR   &kp LBRC  &kp RBRC   &kp LBKT   &kp RBKT   &none   &none   &kp N1     &kp N2     &kp N3     &none      &kp UP  &kp RSHFT
&kp LCTRL  &kp LSHFT  &none     &kp ENTER  &kp SPACE  &to 0      &to 0   &kp N0  &kp ENTER  &kp LEFT   &kp DOWN   &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        Navi_layer {
            display-name = "NAVI";
            bindings = <
&none  &none  &none     &kp UP     &kp PAGE_UP  &kp PAGE_DOWN   &none  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc SCRL_UP    &none
&none  &none  &kp LEFT  &kp DOWN   &kp RIGHT    &msc SCRL_UP    &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &none
&none  &none  &none     &none      &none        &msc SCRL_DOWN  &none  &trans          &trans          &none            &mkp MB3        &none  &none  &none
&none  &none  &none     &kp LSHFT  &kp LCTRL    &to 0           &to 0  &kp LCTRL       &kp LSHFT       &none            &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        Function_layer {
            display-name = "FUNC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none    &none
&none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none    &none    &none  &none
&none   &none   &none   &none   &none   &to 0   &to 1   &none   &none   &none    &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        BLT_layer {
            display-name = "BLT";
            bindings = <
&to 0           &none         &none         &none         &none         &none  &kp N7  &kp N8        &kp N9  &trans  &trans  &trans
&bt BT_CLR_ALL  &bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &none         &none  &kp N4  &kp N5        &kp N6  &trans  &trans  &kp ENTER
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none   &trans        &kp N1  &kp N2  &kp N3  &trans     &trans  &trans
&out OUT_USB    &out OUT_BLE  &out OUT_TOG  &none         &none         &to 0  &to 0   &kp NUMBER_0  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };
    };
};
